# SunSecurityBot — пример конфигурации. Скопируйте в `.env` и заполните.
# ВНИМАНИЕ: реальный `.env` исключён `.gitignore` — не коммитьте его никогда.

# --- Общие ---
APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=json
HOST=0.0.0.0
PORT=8000

# --- VCS (GitHub primary, ADR-1) ---
VCS_PROVIDER=github
# Сервисный аккаунт GitHub: classic PAT с правами `repo`, или GitHub App installation token.
VCS_TOKEN=ghp_your-github-token-here
# HMAC-секрет для проверки X-Hub-Signature-256.
WEBHOOK_SECRET=replace-with-a-long-random-string
GITHUB_API_BASE=https://api.github.com

# --- LLM polza.ai (primary, ADR-2) ---
LLM_PROVIDER=polza
POLZA_API_KEY=your-polza-api-key-here
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_MODEL_ID=gpt-4o-mini
POLZA_BUDGET_LIMIT_RUB=80
POLZA_TIMEOUT_SECONDS=60
POLZA_MAX_RETRIES=3
# Включает direct-fallback на OpenAI/Anthropic (требует валидных ключей).
ALLOW_DIRECT_FALLBACK=false

# --- Pipeline ---
PUBLISH_EMPTY_PR_COMMENT=false
SKIP_DRAFTS=true
STATE_STORE_BACKEND=memory
# T-016: master-switch для CommentPublisher. В test/dev обычно `false`,
# чтобы юнит-смоук не ходил в GitHub. В prod (Docker) — `true`.
PUBLISH_COMMENTS_ENABLED=true

# --- Test UI (dev only, T-023) ---
# Включает GET /ui (страница тестирования) и /api/ui/* endpoints
# (analyze / budget / examples). В prod НЕ включать — даёт прямой доступ
# к polza.ai без HMAC-проверки GitHub-webhook. Защита: оставлять `false`
# и в dev биндить сервис на 127.0.0.1 (HOST=127.0.0.1). См. README раздел
# «Test UI (dev only)» и `tmp/gui_plan.md`.
ENABLE_TEST_UI=false

# --- FalsePositiveFilter (T-013) ---
# Порог confidence для пост-фильтра LLM-находок (0.0..1.0). Дефолт 0.5.
# FP_MIN_CONFIDENCE=0.5
# Если pre-scan нашёл известный секрет — пропускать LLM-вызов целиком (экономия).
# FP_SKIP_LLM_IF_PRESCAN_FOUND=false

# --- DiffFilter (T-009) ---
# Все три переменные — CSV. Если не задана — берётся дефолт из кода
# (`sunsec.filter.config.DEFAULT_EXCLUDE_*`). Если задана пустая строка —
# трактуется как «не переопределять» (т. е. тоже дефолт). Чтобы реально
# отключить какую-то категорию, переопредели её *непустым* значением, не
# содержащим нежелательное расширение/имя.
# Расширения — lowercase, с ведущей точкой; имена файлов — точный basename.
# FILTER_EXCLUDE_EXTENSIONS=.md,.txt,.rst,.png,.jpg,.jpeg,.gif,.webp,.svg,.pdf,.zip,.tar,.gz,.bz2,.xz,.7z,.ico,.bmp,.woff,.woff2,.ttf,.eot,.mp4,.mov,.avi,.mp3,.wav,.exe,.dll,.so,.dylib,.class,.jar,.wasm
# FILTER_EXCLUDE_NAMES=.gitignore,.gitattributes,LICENSE,CHANGELOG,package-lock.json,yarn.lock,pnpm-lock.yaml,Pipfile.lock,poetry.lock,uv.lock,Gemfile.lock,Cargo.lock,composer.lock,go.sum,bun.lockb
# FILTER_EXCLUDE_GLOBS=vendor/**,node_modules/**,dist/**,build/**,*.generated.*,*.min.js,*.min.css,*.map
