# SunSecurityBot — пример конфигурации. Скопируйте в `.env` и заполните.
# ВНИМАНИЕ: реальный `.env` исключён `.gitignore` — не коммитьте его никогда.

# --- Общие ---
APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=json
HOST=0.0.0.0
PORT=8000

# --- VCS (GitHub primary, ADR-1) ---
VCS_PROVIDER=github
# Сервисный аккаунт GitHub: classic PAT с правами `repo`, или GitHub App installation token.
VCS_TOKEN=ghp_your-github-token-here
# HMAC-секрет для проверки X-Hub-Signature-256.
WEBHOOK_SECRET=replace-with-a-long-random-string
GITHUB_API_BASE=https://api.github.com

# --- LLM polza.ai (primary, ADR-2) ---
# LLM_PROVIDER — выбор активного провайдера. Options: `polza` (default, backwards
# compat — gpt-4o-mini через polza.ai) | `openrouter` (T-031, M-8 Replan #4 —
# DeepSeek V4 Flash / Qwen3 Coder (free) / MiMo V2 Pro). Каждый провайдер
# имеет независимую корзину бюджета (POLZA_BUDGET_LIMIT_RUB / OPENROUTER_BUDGET_LIMIT_RUB).
LLM_PROVIDER=polza
POLZA_API_KEY=your-polza-api-key-here
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_MODEL_ID=gpt-4o-mini
POLZA_BUDGET_LIMIT_RUB=80
POLZA_TIMEOUT_SECONDS=60
POLZA_MAX_RETRIES=3
# Включает direct-fallback на OpenAI/Anthropic (требует валидных ключей).
ALLOW_DIRECT_FALLBACK=false

# --- LLM OpenRouter (T-031, M-8 Replan #4) ---
# Чтобы активировать OpenRouter: установи LLM_PROVIDER=openrouter (выше) и
# заполни OPENROUTER_API_KEY реальным ключом sk-or-v1-... (только в `.env`,
# никогда не коммитить в `.env.example` / git).
# Primary модель — `deepseek/deepseek-v4-flash` (T-030 §28). Альтернативы:
# `xiaomi/mimo-v2-pro` (платно, ~13× дороже DeepSeek), `qwen/qwen3-coder:free`
# (бесплатно, но upstream rate-limit ~20 req/min).
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_ID=deepseek/deepseek-v4-flash
# Тарифы для DeepSeek V4 Flash (T-030 §22): $0.112/1M input, $0.224/1M output
# при курсе 95 ₽/USD → 0.01064 ₽/1K input, 0.02128 ₽/1K output.
OPENROUTER_INPUT_RUB_PER_1K=0.01064
OPENROUTER_OUTPUT_RUB_PER_1K=0.02128
# Курс USD→RUB для конверсии `usage.cost` (если OPENROUTER_USE_USAGE_COST=true).
OPENROUTER_USD_RUB_RATE=95.0
# Использовать `usage.cost` от OpenRouter напрямую (приоритет над tariff-table).
# Default false — tariff-режим (предсказуемее для CI/тестов).
OPENROUTER_USE_USAGE_COST=false
# Поддержка `response_format=json_object`. DeepSeek V4 Flash и MiMo V2 Pro — да;
# Qwen3 Coder free — нет (T-030 §24.5 #2). Default false на mixed-rotation.
OPENROUTER_USE_JSON_SCHEMA=false
# `models[]` rotation (T-030 §24.4) — OpenRouter автоматически fallback'ит
# на следующую модель при ошибке/rate-limit primary. Default false.
OPENROUTER_USE_MODELS_ROTATION=false
# CSV список fallback-моделей (используется только при USE_MODELS_ROTATION=true).
# Пример: xiaomi/mimo-v2-pro,xiaomi/mimo-v2-flash,qwen/qwen3-coder:free
OPENROUTER_FALLBACK_MODEL_IDS=
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
# Отдельный kill-switch (независимая корзина от POLZA_BUDGET_LIMIT_RUB).
OPENROUTER_BUDGET_LIMIT_RUB=50

# --- SQLite persistence (M-9, ADR-6) ---
# Если пустая строка / `:memory:` — бот использует InMemoryStateStore
# (legacy ADR-3 поведение M-0..M-8, без durable layer). Любое другое
# значение — путь к SQLite-файлу; директория создаётся автоматически,
# схема инициализируется на startup (CREATE TABLE IF NOT EXISTS).
# Production-default — `./data/sunsec.db` (требует Docker-volume mount).
# SUNSEC_DB_PATH=./data/sunsec.db

# --- Pipeline ---
PUBLISH_EMPTY_PR_COMMENT=false
SKIP_DRAFTS=true
STATE_STORE_BACKEND=memory
# T-016: master-switch для CommentPublisher. В test/dev обычно `false`,
# чтобы юнит-смоук не ходил в GitHub. В prod (Docker) — `true`.
PUBLISH_COMMENTS_ENABLED=true

# --- Test UI (dev only, T-023) ---
# Включает GET /ui (страница тестирования) и /api/ui/* endpoints
# (analyze / budget / examples). В prod НЕ включать — даёт прямой доступ
# к polza.ai без HMAC-проверки GitHub-webhook. Защита: оставлять `false`
# и в dev биндить сервис на 127.0.0.1 (HOST=127.0.0.1). См. README раздел
# «Test UI (dev only)» и `tmp/gui_plan.md`.
ENABLE_TEST_UI=false

# --- Console UI control plane (M-9, T-039) ---
# Включает `/api/console/*` endpoints (10 endpoint'ов:
# `budget` / `settings` / `checks[*]` / `repos[*]` / `manual/analyze` /
# `dashboard`). По умолчанию выключен, чтобы не ломать M-0..M-8 деплои.
#
# ВАЖНО (system_design v1.2.1 §11.7 R-13 HIGH): MVP не имеет authn —
# `/api/console/*` НЕ выставлять в публичную сеть без middleware
# (basic-auth / JWT / VPN). Single-user dev-режим.
#
# Токены, регистрируемые через POST /api/console/repos, сохраняются в
# gitignored `data/repos_secrets.env` (durability fix RT-012, см. R-18)
# плюс `os.environ` текущего процесса. На startup в `app.py` файл
# подгружается через `load_dotenv("data/repos_secrets.env",
# override=False)` ДО инициализации Settings. Рекомендуется держать
# `data/` на persistent volume в production.
ENABLE_CONSOLE_UI=false

# --- FalsePositiveFilter (T-013) ---
# Порог confidence для пост-фильтра LLM-находок (0.0..1.0). Дефолт 0.5.
# FP_MIN_CONFIDENCE=0.5
# Если pre-scan нашёл известный секрет — пропускать LLM-вызов целиком (экономия).
# FP_SKIP_LLM_IF_PRESCAN_FOUND=false

# --- DiffFilter (T-009) ---
# Все три переменные — CSV. Если не задана — берётся дефолт из кода
# (`sunsec.filter.config.DEFAULT_EXCLUDE_*`). Если задана пустая строка —
# трактуется как «не переопределять» (т. е. тоже дефолт). Чтобы реально
# отключить какую-то категорию, переопредели её *непустым* значением, не
# содержащим нежелательное расширение/имя.
# Расширения — lowercase, с ведущей точкой; имена файлов — точный basename.
# FILTER_EXCLUDE_EXTENSIONS=.md,.txt,.rst,.png,.jpg,.jpeg,.gif,.webp,.svg,.pdf,.zip,.tar,.gz,.bz2,.xz,.7z,.ico,.bmp,.woff,.woff2,.ttf,.eot,.mp4,.mov,.avi,.mp3,.wav,.exe,.dll,.so,.dylib,.class,.jar,.wasm
# FILTER_EXCLUDE_NAMES=.gitignore,.gitattributes,LICENSE,CHANGELOG,package-lock.json,yarn.lock,pnpm-lock.yaml,Pipfile.lock,poetry.lock,uv.lock,Gemfile.lock,Cargo.lock,composer.lock,go.sum,bun.lockb
# FILTER_EXCLUDE_GLOBS=vendor/**,node_modules/**,dist/**,build/**,*.generated.*,*.min.js,*.min.css,*.map
